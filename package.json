{
  "name": "docusync-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "desktop",
    "web",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --prefix web",
    "dev:desktop": "npm run dev:electron --prefix desktop",
    "dev:web": "npm run dev --prefix web",
    "dev:mobile": "npm start --prefix mobile",
    "test:all": "npm test --prefix desktop",
    "build:web": "npm run build --prefix web"
  },
  "devDependencies": {
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "electron": true,
    "esbuild": true,
    "prisma": true,
    "unrs-resolver@1.12.2": true
  },
  "dependencies": {
    "@tiptap/extension-table": "^3.31.0",
    "@tiptap/extension-table-cell": "^3.31.0",
    "@tiptap/extension-table-header": "^3.31.0",
    "@tiptap/extension-table-row": "^3.31.0"
  }
}
