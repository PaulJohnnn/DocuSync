{
  "name": "docusync-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "desktop",
    "web",
    "mobile",
    "shared"
  ],
  "scripts": {
    "dev:desktop": "cd \"desktop\" ; npm run dev:electron",
    "dev:web": "cd \"web\" ; npm run dev",
    "dev:mobile": "cd \"mobile\" ; npx expo start",
    "test:all": "cd \"desktop\" ; npm test",
    "build:web": "cd \"web\" ; npm run build"
  }
}
