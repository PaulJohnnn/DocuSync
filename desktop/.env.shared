# ============================================================
# DocuSync Desktop — Shared Environment Config
# ============================================================
# HOW TO USE:
#   1. Pull this file from GitHub
#   2. Copy/rename it to `.env` in the desktop/ folder:
#        cp .env.shared .env        (Mac/Linux)
#        copy .env.shared .env      (Windows)
#   3. Run: npm run dev:desktop
# ============================================================

# VITE_WEB_URL — Points the desktop app to the web matchmaker server.
# This is the LAN IP of the machine running `npm run dev` (web server).
# All desktop devices on the same Wi-Fi must point here.
VITE_WEB_URL=http://192.168.68.107:3000
